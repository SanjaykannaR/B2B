# ============================================================
# CLIENT ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# Backend API base URL
VITE_API_URL=http://localhost:5000/api

# Leaflet map tile provider (free, no token needed for OpenStreetMap)
# If using a premium tile provider, add the token here:
# VITE_MAP_TOKEN=your-map-token-here
