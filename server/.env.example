# ============================================================
# SERVER ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

PORT=5000
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/b2b-logistics?retryWrites=true&w=majority
JWT_SECRET=b2b-logistics-super-secret-key-change-in-production-2026
JWT_EXPIRES_IN=7d
NODE_ENV=development

# Email (Nodemailer) — for overdue delivery notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-here

# Frontend URL (for CORS whitelist)
CLIENT_URL=http://localhost:5173
